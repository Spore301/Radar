# Copy to `.env` on the server and fill in every value. Never commit `.env`.

# The public address Caddy serves. A hostname gets automatic HTTPS.
SITE_ADDRESS=radr.example.com

# Auth.js — generate with:  openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# The public origin, with https:// and no trailing slash. Required: behind the
# proxy, Next's standalone server builds request URLs from its own bind address
# (0.0.0.0:3000), so without this the Google callback URL is wrong.
AUTH_URL=https://radr.example.com

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI:  https://<SITE_ADDRESS>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who may sign in. Either a Google Workspace domain (everyone on it gets in)…
ALLOWED_GOOGLE_DOMAIN=example.com
# …or leave it empty and add invites per email with deploy/invite.sh.

# Who may read every tester's feedback and mark it resolved (comma-separated
# Google account emails). Everyone else sees only their own reports. Grants
# nothing else: sessions and candidates stay strictly per user.
ADMIN_EMAILS=

# LLM used for JD parsing, query vocabulary and outreach drafts.
DEEPSEEK_API_KEY=

# Optional server-wide fallback SerpAPI key. Normally each recruiter adds their
# own key during onboarding, so this can stay empty.
SERPAPI_KEY=

# DATABASE_URL is set by docker-compose.yml (file:/data/radar.db). Leave it out.
