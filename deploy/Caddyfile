# Reverse proxy in front of the app container.
#
# SITE_ADDRESS comes from .env (docker-compose passes it through). With a real
# hostname such as radr.example.com Caddy obtains and renews a Let's Encrypt
# certificate on its own and redirects http:// to https://. For a plain
# "http://<ip>" address it serves unencrypted HTTP, which Google sign-in will
# refuse, so use a hostname for anything beyond a smoke test.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Long cache for Next's hashed build assets and the hero media. Set on the
	# response coming back from the app (header_down), which replaces Next's
	# own Cache-Control. A plain `header` here would run before the proxy and
	# leave two Cache-Control headers on the response.
	@static path /_next/static/* /hero/* /brand/*
	handle @static {
		reverse_proxy app:3000 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		reverse_proxy app:3000
	}
}
